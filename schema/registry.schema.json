{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/mr-ruhid/rj_cms_theme_and_plugin_list/main/schema/registry.schema.json",
    "title": "RJ CMS Registry",
    "description": "Schema for the RJ CMS theme and plugin registry.",
    "type": "object",
    "required": ["version", "updated_at", "themes", "plugins"],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+$",
            "description": "Registry format version (e.g. 1.0)"
        },
        "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp in UTC ISO 8601 format"
        },
        "themes": {
            "type": "array",
            "description": "List of approved theme repositories",
            "items": {
                "$ref": "#/definitions/entry"
            }
        },
        "plugins": {
            "type": "array",
            "description": "List of approved plugin repositories",
            "items": {
                "$ref": "#/definitions/entry"
            }
        }
    },
    "definitions": {
        "entry": {
            "type": "object",
            "required": ["repo", "verified"],
            "additionalProperties": false,
            "properties": {
                "repo": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9]|-(?=[a-zA-Z0-9])){0,38}/[a-zA-Z0-9._-]+$",
                    "description": "GitHub repository in owner/repo format"
                },
                "verified": {
                    "type": "boolean",
                    "description": "Set to true by maintainers after review"
                },
                "featured": {
                    "type": "boolean",
                    "description": "Featured on the browse page (maintainers only)"
                },
                "category": {
                    "type": "string",
                    "description": "Primary category",
                    "enum": [
                        "general",
                        "blog",
                        "magazine",
                        "portfolio",
                        "shop",
                        "business",
                        "landing",
                        "photography",
                        "seo",
                        "analytics",
                        "forms",
                        "ecommerce",
                        "social",
                        "security",
                        "performance",
                        "marketing",
                        "utilities"
                    ]
                },
                "tags": {
                    "type": "array",
                    "description": "Search keywords (max 5)",
                    "maxItems": 5,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{0,29}$",
                        "description": "Lowercase, hyphenated, max 30 chars"
                    }
                },
                "notes": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Optional maintainer note (internal use)"
                }
            }
        }
    }
}